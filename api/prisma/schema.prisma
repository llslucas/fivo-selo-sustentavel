// Schema derivado das entidades de domínio (AD-017): a fonte da verdade é
// `src/domain/fivo/entities/`. Value objects (Cnpj, Senha) viram colunas de
// texto — a validação acontece no domínio antes de chegar aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPRESA
  INSTITUICAO

  @@map("user_role")
}

enum EmpresaStatus {
  PENDENTE_APROVACAO
  APROVADA
  REJEITADA
  SUSPENSA

  @@map("empresa_status")
}

enum InstituicaoStatus {
  PENDENTE_APROVACAO
  APROVADA
  REJEITADA
  SUSPENSA
  INATIVA

  @@map("instituicao_status")
}

enum CausaStatus {
  ATIVA
  INATIVA

  @@map("causa_status")
}

enum CampanhaStatus {
  RASCUNHO
  EM_ANALISE
  APROVADA
  REJEITADA

  @@map("campanha_status")
}

enum AlteracaoCampanhaStatus {
  EM_ANALISE
  APROVADA
  REJEITADA

  @@map("alteracao_campanha_status")
}

enum TipoRegraDoacao {
  POR_UNIDADE
  PERCENTUAL

  @@map("tipo_regra_doacao")
}

enum TipoArquivo {
  LOGO_EMPRESA
  LOGO_INSTITUICAO
  DOCUMENTO_INSTITUICAO
  IMAGEM_CAMPANHA

  @@map("tipo_arquivo")
}

model Usuario {
  id              String    @id
  nome            String
  email           String    @unique
  senhaHash       String    @map("senha_hash")
  role            UserRole
  falhasLogin     Int       @default(0) @map("falhas_login")
  primeiraFalhaEm DateTime? @map("primeira_falha_em")
  bloqueadoAte    DateTime? @map("bloqueado_ate")
  criadoEm        DateTime  @map("criado_em")
  atualizadoEm    DateTime? @map("atualizado_em")

  empresa     Empresa?
  instituicao Instituicao?
  sessoes     Sessao[]
  tokensSenha TokenSenha[]

  @@map("usuario")
}

model Empresa {
  id                      String        @id
  usuarioId               String?       @unique @map("usuario_id")
  razaoSocial             String        @map("razao_social")
  nomeFantasia            String        @map("nome_fantasia")
  cnpj                    String        @unique
  telefone                String
  cep                     String
  logradouro              String
  numero                  String
  complemento             String?
  bairro                  String
  cidade                  String
  uf                      String        @db.Char(2)
  site                    String
  contato                 String
  logoArquivoId           String?       @map("logo_arquivo_id")
  status                  EmpresaStatus
  decididoPor             String?       @map("decidido_por")
  decididoEm              DateTime?     @map("decidido_em")
  motivoDecisao           String?       @map("motivo_decisao")
  emailPendente           String?       @map("email_pendente")
  tokenTrocaEmailHash     String?       @map("token_troca_email_hash")
  tokenTrocaEmailExpiraEm DateTime?     @map("token_troca_email_expira_em")
  criadoEm                DateTime      @map("criado_em")
  atualizadoEm            DateTime?     @map("atualizado_em")

  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  logo      Arquivo?   @relation(fields: [logoArquivoId], references: [id])
  campanhas Campanha[]

  // Fila de aprovação: filtra por status e ordena por data de cadastro (EMP-04 AC1).
  @@index([status, criadoEm], map: "empresa_status_criado_em_idx")
  @@map("empresa")
}

// Taxonomia curada pelo admin (INST-07). `nomeBusca` é o nome em minúsculas e
// sem acento, gravado pelo mapper: o índice único faz "Educação" e "educacao"
// serem a mesma causa.
model Causa {
  id           String      @id
  nome         String
  nomeBusca    String      @unique @map("nome_busca")
  descricao    String
  status       CausaStatus
  criadoEm     DateTime    @map("criado_em")
  atualizadoEm DateTime?   @map("atualizado_em")

  instituicoes Instituicao[]
  campanhas    Campanha[]

  @@map("causa")
}

// Perfil da instituição, 1-1 com `usuario` (papel INSTITUICAO). O CNPJ é único
// só nesta tabela: empresa e instituição podem repetir CNPJ (spec, Edge cases).
// A busca do catálogo é feita no caso de uso, sem coluna derivada aqui (T47).
model Instituicao {
  id                 String            @id
  usuarioId          String?           @unique @map("usuario_id")
  razaoSocial        String            @map("razao_social")
  nomeFantasia       String            @map("nome_fantasia")
  cnpj               String            @unique
  telefone           String
  cep                String
  logradouro         String
  numero             String
  complemento        String?
  bairro             String
  cidade             String
  uf                 String            @db.Char(2)
  site               String
  contato            String
  descricao          String
  causaId            String            @map("causa_id")
  logoArquivoId      String?           @map("logo_arquivo_id")
  documentoArquivoId String            @map("documento_arquivo_id")
  documentoDescricao String?           @map("documento_descricao")
  status             InstituicaoStatus
  decididoPor        String?           @map("decidido_por")
  decididoEm         DateTime?         @map("decidido_em")
  motivoDecisao      String?           @map("motivo_decisao")
  criadoEm           DateTime          @map("criado_em")
  atualizadoEm       DateTime?         @map("atualizado_em")

  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  causa     Causa      @relation(fields: [causaId], references: [id])
  logo      Arquivo?   @relation("LogoInstituicao", fields: [logoArquivoId], references: [id])
  documento Arquivo    @relation("DocumentoInstituicao", fields: [documentoArquivoId], references: [id])
  campanhas Campanha[]

  // Fila de análise: filtra por status e ordena por data de cadastro (INST-04).
  @@index([status, criadoEm], map: "instituicao_status_criado_em_idx")
  // Inativação de causa: instituições aprovadas vinculadas (INST-07 AC4).
  @@index([causaId, status], map: "instituicao_causa_id_status_idx")
  @@map("instituicao")
}

model Sessao {
  id             String    @id
  usuarioId      String    @map("usuario_id")
  tokenHash      String    @unique @map("token_hash")
  criadaEm       DateTime  @map("criada_em")
  ultimoAcessoEm DateTime  @map("ultimo_acesso_em")
  revogadaEm     DateTime? @map("revogada_em")
  ip             String?
  userAgent      String?   @map("user_agent")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "sessao_usuario_id_idx")
  @@map("sessao")
}

// Log append-only: sem FK forte (design.md — log desacoplado) e sem update/delete
// exposto no repositório.
model RegistroAuditoria {
  id         String   @id
  tipo       String
  descricao  String
  usuarioId  String?  @map("usuario_id")
  entidadeId String?  @map("entidade_id")
  dados      Json?
  criadoEm   DateTime @map("criado_em")

  @@index([entidadeId], map: "registro_auditoria_entidade_id_idx")
  @@map("registro_auditoria")
}

model TokenSenha {
  id        String    @id
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  criadoEm  DateTime  @map("criado_em")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "token_senha_usuario_id_idx")
  @@map("token_senha")
}

model Arquivo {
  id           String      @id
  tipo         TipoArquivo
  nomeOriginal String      @map("nome_original")
  mime         String
  bytes        Int
  largura      Int?
  altura       Int?
  chaveStorage String      @map("chave_storage")
  svgConteudo  String?     @map("svg_conteudo")
  criadoEm     DateTime    @default(now()) @map("criado_em")

  empresas                Empresa[]
  logosDeInstituicao      Instituicao[] @relation("LogoInstituicao")
  documentosDeInstituicao Instituicao[] @relation("DocumentoInstituicao")
  campanha                Campanha?

  @@map("arquivo")
}

// Campanha de impacto social (CAMP-01…08, CAMP-11). Dinheiro em centavos e
// percentual em centésimos de ponto (inteiros); vigência em datas de
// calendário (`@db.Date`). O CHECK de beneficiada (instituição ou causa, nunca
// as duas) está em SQL manual na migration `campanhas`.
model Campanha {
  id                        String           @id
  idPublico                 String           @unique @map("id_publico")
  empresaId                 String           @map("empresa_id")
  nome                      String
  descricao                 String?
  capaArquivoId             String?          @unique @map("capa_arquivo_id")
  instituicaoId             String?          @map("instituicao_id")
  causaId                   String?          @map("causa_id")
  regraTipo                 TipoRegraDoacao? @map("regra_tipo")
  regraValorCentavos        Int?             @map("regra_valor_centavos")
  regraPercentualCentesimos Int?             @map("regra_percentual_centesimos")
  metaCentavos              Int?             @map("meta_centavos")
  dataInicio                DateTime?        @map("data_inicio") @db.Date
  dataFim                   DateTime?        @map("data_fim") @db.Date
  status                    CampanhaStatus
  submetidaEm               DateTime?        @map("submetida_em")
  decididoPor               String?          @map("decidido_por")
  decididoEm                DateTime?        @map("decidido_em")
  motivoUltimaRejeicao      String?          @map("motivo_ultima_rejeicao")
  versao                    Int              @default(0)
  criadoEm                  DateTime         @map("criado_em")
  atualizadoEm              DateTime?        @map("atualizado_em")

  empresa     Empresa             @relation(fields: [empresaId], references: [id])
  instituicao Instituicao?        @relation(fields: [instituicaoId], references: [id])
  causa       Causa?              @relation(fields: [causaId], references: [id])
  capa        Arquivo?            @relation(fields: [capaArquivoId], references: [id])
  alteracoes  CampanhaAlteracao[]

  @@index([status])
  @@index([empresaId])
  @@map("campanha")
}

// Alteração de compromisso de campanha aprovada (CAMP-08), com histórico das
// decisões. O compromisso anterior não vira coluna: enquanto a alteração está
// pendente, é o que está na campanha. O CHECK de beneficiada (exatamente uma)
// e o índice único parcial "uma alteração EM_ANALISE por campanha" estão em
// SQL manual na migration `campanhas`.
model CampanhaAlteracao {
  id                        String                  @id
  campanhaId                String                  @map("campanha_id")
  instituicaoId             String?                 @map("instituicao_id")
  causaId                   String?                 @map("causa_id")
  regraTipo                 TipoRegraDoacao         @map("regra_tipo")
  regraValorCentavos        Int?                    @map("regra_valor_centavos")
  regraPercentualCentesimos Int?                    @map("regra_percentual_centesimos")
  dataInicio                DateTime                @map("data_inicio") @db.Date
  dataFim                   DateTime?               @map("data_fim") @db.Date
  status                    AlteracaoCampanhaStatus
  motivo                    String?
  decididoPor               String?                 @map("decidido_por")
  decididoEm                DateTime?               @map("decidido_em")
  criadoEm                  DateTime                @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id])

  @@index([campanhaId])
  @@map("campanha_alteracao")
}

// Fila de reenvio de e-mail transacional (EMP-01 AC9, EMP-04). Só templates sem
// segredo entram aqui; `dados` nunca carrega token.
model EmailPendente {
  id                 String    @id
  para               String
  template           String
  dados              Json?
  tentativas         Int       @default(0)
  proximaTentativaEm DateTime  @map("proxima_tentativa_em")
  enviadoEm          DateTime? @map("enviado_em")
  esgotadoEm         DateTime? @map("esgotado_em")
  criadoEm           DateTime  @map("criado_em")

  @@index([enviadoEm, esgotadoEm, proximaTentativaEm], map: "email_pendente_fila_idx")
  @@map("email_pendente")
}
