# Postgres de desenvolvimento/teste — bate com docker-compose.test.yml
DATABASE_URL="postgresql://fivo:fivo@localhost:5433/fivo_test?schema=public"

# Diretório raiz do storage de arquivos em disco local (LocalDiskStorage)
STORAGE_DIR="./tmp/storage"

# Seed idempotente do administrador (criado no boot se ainda não existir)
ADMIN_EMAIL="admin@fivo.test"
ADMIN_SENHA="troque-esta-senha-10+"
ADMIN_NOME="Administrador Fivo"

# Cookie de sessão com flag Secure (padrão: ligado quando NODE_ENV=production)
COOKIE_SECURE="false"

# Serve /docs (Swagger UI) e /docs/openapi.json em produção (fora dela já é servido)
SWAGGER_ENABLED="false"

# E-mail por SMTP (Brevo: smtp-relay.brevo.com, porta 587; o usuário é o
# "login SMTP" do painel e a senha é a chave SMTP). Sem SMTP_HOST, os e-mails
# só vão para o log (LogMailer) — em produção, a app não sobe sem ele. Nos
# testes (NODE_ENV=test) é sempre o LogMailer, mesmo com isto preenchido.
# EMAIL_REMETENTE precisa ser um remetente verificado no provedor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_SENHA=""
EMAIL_REMETENTE="Fivo <nao-responda@exemplo.com.br>"

# URL do frontend (pasta ../web). É a base do QR Code do selo
# ({WEB_URL}/empresa/{slugEmpresa}/{slugCampanha}): obrigatória em produção,
# senão a app não sobe. Fora de produção, o LogMailer escreve no log o link de
# redefinição de senha apontando pra cá.
WEB_URL="http://localhost:3001"
