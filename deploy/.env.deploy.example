# Configuração do deploy manual (deploy\deploy-manual.ps1).
#
#   copy deploy\.env.deploy.example deploy\.env.deploy
#
# deploy\.env.deploy é ignorado pelo git: NUNCA commite esse arquivo.
# Valores sem aspas simples e sem quebra de linha.

# --- Servidor ---------------------------------------------------------------
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Caminho da chave privada (.pem). Guarde FORA da pasta do projeto.
# Se o ssh reclamar de "UNPROTECTED PRIVATE KEY FILE", rode no PowerShell:
#   icacls "C:\caminho\chave.pem" /inheritance:r /grant:r "$($env:USERNAME):R"
SSH_KEY=C:\Users\SEU_USUARIO\.ssh\issoimporta.pem
# Pasta da aplicação no servidor (o usuário SSH precisa poder escrever nela).
DEPLOY_DIR=/opt/issoimporta

# --- Aplicação ----------------------------------------------------------------
# Base do link do QR Code do selo: não mude depois de imprimir selos.
WEB_URL=https://issoimporta.app
# Porta livre no servidor; o web escuta só em 127.0.0.1 e o nginx faz o HTTPS.
WEB_PORT=3101

POSTGRES_USER=fivo
POSTGRES_DB=fivo
# Deixe vazio no primeiro deploy: o script gera uma senha e grava aqui.
# Depois NÃO troque (o Postgres só usa a senha ao criar o banco).
POSTGRES_PASSWORD=

# Admin criado no primeiro boot (10+ caracteres na senha).
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador Fivo

# SMTP do Brevo (login SMTP e chave SMTP do painel).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
# Remetente verificado no Brevo (domínio com SPF e DKIM).
EMAIL_REMETENTE=Isso Importa <nao-responda@issoimporta.app>
