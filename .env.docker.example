# Variáveis do docker-compose.yml. Copie para .env (na raiz) e preencha.

POSTGRES_USER=fivo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fivo

# URL pública do web, sem barra no final. É a base do link gravado no QR Code
# do selo: defina o domínio definitivo antes de liberar os downloads.
WEB_URL=https://issoimporta.app

ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_SENHA=troque-esta-senha-10+
ADMIN_NOME=Administrador Fivo

# SMTP (obrigatório: sem SMTP_HOST, a API não sobe em produção).
# Brevo: smtp-relay.brevo.com, porta 587, login SMTP e chave SMTP do painel.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-login@smtp-brevo.com
SMTP_SENHA=sua-chave-smtp
# Remetente verificado no provedor (domínio com SPF e DKIM configurados).
EMAIL_REMETENTE="Fivo <nao-responda@exemplo.com.br>"

# Deixe true atrás de HTTPS. Para testar localmente em http://localhost, use false.
COOKIE_SECURE=true
SWAGGER_ENABLED=false

# Porta publicada do web no host.
WEB_PORT=3001
